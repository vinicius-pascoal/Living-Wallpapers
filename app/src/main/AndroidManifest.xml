<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.LivingWallpapers"
        android:icon="@drawable/app_icon"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Um serviço por cena: cada um é um wallpaper diferente para o sistema, então dá
             para usar cenas distintas na tela inicial e na tela de bloqueio. -->
        <service
            android:name=".wallpaper.ForestWallpaperService"
            android:label="@string/wallpaper_forest_name"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_forest" />
        </service>

        <service
            android:name=".wallpaper.GalaxyWallpaperService"
            android:label="@string/wallpaper_galaxy_name"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_galaxy" />
        </service>

        <service
            android:name=".wallpaper.FantasyWallpaperService"
            android:label="@string/wallpaper_fantasy_name"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_fantasy" />
        </service>
    </application>
</manifest>
